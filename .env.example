# Copy to ~/.harbor/.env (or ./.env) and fill in.
#
# Google OAuth client of type "Desktop app".
# Console -> APIs & Services -> Credentials -> Create OAuth client ID -> Desktop app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key for the reasoning layer.
ANTHROPIC_API_KEY=

# Optional overrides.
# HARBOR_HOME=/Users/you/.harbor
# HARBOR_MODEL=claude-sonnet-5
# HARBOR_TIMEZONE=America/New_York

# Embeddings. Defaults point at Ollama with nomic-embed-text; nothing to set
# if that is what you are running.
# HARBOR_EMBED=http                 # or: local (in-process, optional dep)
# HARBOR_EMBED_URL=http://127.0.0.1:11434/v1/embeddings
# HARBOR_EMBED_MODEL=nomic-embed-text
# HARBOR_EMBED_KEY=
